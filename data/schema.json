{
  "categories": [
    {
      "id": "kaoyan",
      "label": "考研",
      "description": "备考、复试与录取经历"
    },
    {
      "id": "overseas",
      "label": "留学",
      "description": "选校、申请与海外求学"
    },
    {
      "id": "career",
      "label": "就业",
      "description": "实习、校招与职场起步"
    },
    {
      "id": "public",
      "label": "考公考编",
      "description": "备考、招录与面试经验"
    }
  ],
  "fields": [
    {
      "name": "author",
      "label": "姓名 / 昵称",
      "type": "text",
      "required": true,
      "maxLength": 60,
      "placeholder": "用于署名和经历列表"
    },
    {
      "name": "year",
      "label": "本科毕业届次",
      "type": "text",
      "required": true,
      "maxLength": 4,
      "placeholder": "例如 2026",
      "inputMode": "numeric",
      "pattern": "[0-9]{4}",
      "suffix": "届",
      "hint": "仅填写四位毕业年份。"
    },
    {
      "name": "destination",
      "label": "去向单位",
      "type": "text",
      "required": true,
      "maxLength": 160,
      "placeholders": {
        "kaoyan": "例如 北京理工大学",
        "overseas": "例如 香港中文大学",
        "career": "例如 字节跳动",
        "public": "例如 广东省某单位"
      }
    },
    {
      "name": "program",
      "label": "专业 / 项目 / 岗位",
      "type": "text",
      "required": false,
      "maxLength": 120,
      "placeholders": {
        "kaoyan": "例如 计算机科学与技术",
        "overseas": "例如 MSc@CS",
        "career": "例如 前端工程师",
        "public": "例如 综合管理岗"
      }
    },
    {
      "name": "body",
      "label": "经历正文",
      "type": "textarea",
      "required": true,
      "placeholder": "写下准备过程、关键节点、经验教训，以及想对学弟学妹说的话",
      "hint": "支持直接粘贴 Markdown；可载入示例并切换预览。",
      "maxLength": 12000
    },
    {
      "name": "contact",
      "label": "联系方式",
      "type": "textarea",
      "required": false,
      "placeholder": "选填公开邮箱或社交账号",
      "hint": "仅填写愿意公开的信息；正式发布时可能公开展示。",
      "maxLength": 4000
    }
  ]
}
