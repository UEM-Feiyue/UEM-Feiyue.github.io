{
  "categories": [
    {
      "id": "kaoyan",
      "label": "考研",
      "description": "备考、复试与录取经历"
    },
    {
      "id": "overseas",
      "label": "留学",
      "description": "选校、申请与海外求学"
    },
    {
      "id": "career",
      "label": "就业",
      "description": "实习、校招与职场起步"
    },
    {
      "id": "public",
      "label": "考公考编",
      "description": "备考、招录与面试经验"
    }
  ],
  "fields": [
    {
      "name": "title",
      "label": "文章标题",
      "type": "text",
      "required": true,
      "maxLength": 120
    },
    {
      "name": "author",
      "label": "署名 / 昵称",
      "type": "text",
      "required": true,
      "maxLength": 60
    },
    {
      "name": "year",
      "label": "本科毕业届次",
      "type": "text",
      "required": true,
      "maxLength": 4,
      "placeholder": "例如 2026",
      "inputMode": "numeric",
      "pattern": "[0-9]{4}",
      "suffix": "届",
      "hint": "仅填写四位毕业年份，无需输入「届」字。"
    },
    {
      "name": "school",
      "label": "学院",
      "type": "text",
      "maxLength": 80,
      "placeholder": "填写就读时的学院名称",
      "required": true
    },
    {
      "name": "major",
      "label": "本科专业",
      "type": "text",
      "maxLength": 80,
      "placeholder": "填写本科专业",
      "required": true
    },
    {
      "name": "destination",
      "label": "最终去向",
      "type": "text",
      "maxLength": 160,
      "placeholders": {
        "kaoyan": "录取院校 / 专业",
        "overseas": "录取院校 / 项目",
        "career": "入职企业 / 岗位",
        "public": "录用单位 / 岗位"
      },
      "required": true
    },
    {
      "name": "background",
      "label": "个人背景",
      "type": "textarea",
      "placeholder": "成绩、语言、科研、竞赛、实习等与经历相关的信息",
      "required": true
    },
    {
      "name": "contact",
      "label": "联系方式",
      "type": "textarea",
      "placeholder": "邮箱、微信、QQ、GitHub、个人主页等",
      "hint": "仅填写愿意公开的信息，未来正式投稿将公开展示。",
      "required": false
    },
    {
      "name": "body",
      "label": "经历正文",
      "type": "textarea",
      "required": true,
      "placeholder": "从背景、准备过程、关键节点、经验教训到给学弟学妹的建议，自由书写",
      "hint": "可视化编辑，支持标题、列表、加粗、引用和链接；内容保存为 Markdown 草稿。"
    }
  ]
}
